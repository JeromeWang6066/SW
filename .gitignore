*.h5
*.hdf5
*.npz
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.pkl
*.pickle
*.zip
*.tar
*.tar.gz
*.7z

# --- Checkpoints / logs ---
checkpoints/**
!checkpoints/.gitkeep
runs/
outputs/
logs/
wandb/
lightning_logs/
*.log

# --- Notebooks checkpoints ---
.ipynb_checkpoints/

# --- Large binaries / papers (link only; do not commit PDFs) ---
*.pdf
*.bin
*.onnx
