.env
.env.*
!.env.example

# --- IDE / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Data & experiment artifacts (keep layout via .gitkeep) ---
data/raw/**
!data/raw/.gitkeep
data/processed/**/*
!data/processed/.gitkeep
!data/processed/ny/
!data/processed/ny/.gitkeep
!data/processed/chi/
!data/processed/chi/.gitkeep
!data/processed/dc/
!data/processed/dc/.gitkeep
*.csv
